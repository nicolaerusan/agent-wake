{
  "name": "agent-wake",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Wake agents from events: a vendor-neutral event hub, subscriptions with cursors, thin pings, and a spawner that wakes Claude Code, Codex, or any agent CLI.",
  "bin": {
    "agent-wake": "bin/agent-wake.mjs"
  },
  "files": [
    "bin/",
    "hub.mjs",
    "spawner.mjs",
    "mcp.mjs",
    "ingest.mjs",
    "examples/",
    "SECURITY.md",
    "ARCHITECTURE.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicolaerusan/agent-wake.git"
  },
  "scripts": {
    "hub": "node hub.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
